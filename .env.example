# LeaseDesk runtime mode: demo or production.
LEASEDESK_MODE=demo

# Required only when LEASEDESK_MODE=production.
DATABASE_URL=
SESSION_SECRET=
LEASEDESK_ADMIN_USERNAME=
LEASEDESK_UPLOAD_DIR=

# Use exactly one production admin bootstrap credential.
# Prefer LEASEDESK_ADMIN_PASSWORD_HASH after generating a secure hash.
LEASEDESK_ADMIN_PASSWORD=
LEASEDESK_ADMIN_PASSWORD_HASH=
